{
  "name": "greenzo-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Greenzo.in — Luxury Biophilic E-Commerce Storefront & Full-Stack Nursery Ledger (React + Vite + Express + SQLite/Prisma)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "seed": "node --no-warnings scripts/seed.mjs",
    "verify": "node --no-warnings scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
