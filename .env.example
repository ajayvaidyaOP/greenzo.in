# Greenzo.in — environment template
# Copy to .env and fill in your values:  cp .env.example .env
#
# The backend does NOT auto-load this file. Either:
#   cd backend && node --no-warnings --env-file=../.env src/index.js
# or export the variables in your shell / set them in your host dashboard.
# Never commit a real .env — it is git-ignored.

# ---- Server ----
PORT=4000
HOST=0.0.0.0

# ---- Storage (use a persistent disk path in production) ----
DB_PATH=backend/data/greenzo.sqlite
UPLOADS_DIR=backend/uploads

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ---- Razorpay (optional; values saved in Admin Studio override these) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
